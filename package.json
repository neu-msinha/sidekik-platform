{
  "name": "@sidekik/contracts",
  "version": "0.1.0",
  "description": "Shared contracts, decision specs and stream names for Sidekik services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "bash scripts/release.sh",
    "seed:gen": "tsx scripts/gen-seed.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "replay": "tsx dev/replay.ts",
    "fixtures:gen": "tsx scripts/gen-fixtures.ts",
    "test:presidio": "PRESIDIO_ANALYZER_URL=${PRESIDIO_ANALYZER_URL:-http://localhost:5002} PRESIDIO_ANONYMIZER_URL=${PRESIDIO_ANONYMIZER_URL:-http://localhost:5001} vitest run test/presidio.test.ts"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^20.19.0",
    "json-logic-js": "^2.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
